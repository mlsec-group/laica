Bootstrap: docker
From: tensorflow/tensorflow:2.9.0-gpu
Stage: spython-base

%files
    $PWD/lib/debsack/ /debsack
    $PWD/lib/gensim/ /gensim
    $PWD/lib/binary-code-embeddings/ /binary-code-embeddings

%post
  apt-key del 7fa2af80
  rm /etc/apt/sources.list.d/cuda.list
  curl https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/x86_64/cuda-keyring_1.0-1_all.deb -o ./cuda-keyring_1.0-1_all.deb
  curl https://developer.download.nvidia.com/compute/cuda/repos/ubuntu1804/x86_64/cuda-keyring_1.0-1_all.deb -o ./cuda-keyring_1.0-1_all.deb
  dpkg -i cuda-keyring_1.0-1_all.deb

  apt-get update
  apt-get install -y vim cmake time

  pip3 install \
    datasets==3.1.0 \
    tqdm==4.67.1 \
    transformers==4.46.3 \
    torch==2.4.1 \
    liger-kernel==0.5.4 \
    scikit-learn==1.3.2 \
    accelerate==1.0.1 \
    click==8.1.8 \
    tensorboard==2.14.0 \
    tensorflow-text==2.9.0 \
    angr==9.2.102 \
    keystone-engine==0.9.2 \
    optuna==4.0.0 \
    unix_ar==0.2.1

  cd /gensim
  pip3 install .

  cd /debsack
  pip3 install .

  cd /binary-code-embeddings
  pip3 install .


  python3 -c 'from transformers import AutoTokenizer; AutoTokenizer.from_pretrained("lt-asset/nova-1.3b", cache_dir="/cache")'
  python3 -c 'from transformers import LlamaModel; LlamaModel.from_pretrained("lt-asset/nova-1.3b", cache_dir="/cache")'
